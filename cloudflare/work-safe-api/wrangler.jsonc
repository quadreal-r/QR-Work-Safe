{
  "name": "work-safe-api",
  "main": "src/index.js",
  // Krutki11 account (owns insp360.ca) — same place as Email Sending domain.
  "account_id": "e46c718ce72e30e61182c9b1c04cf286",
  "compatibility_date": "2026-07-23",
  "workers_dev": true,
  "routes": [
    { "pattern": "api.worksafe.insp360.ca/*", "zone_name": "insp360.ca" }
  ],
  "vars": {
    "TOKEN_EPOCH": "1",
    "SUPABASE_URL": "https://wyiymdtlncperqpwriuk.supabase.co",
    "EMAIL_FROM": "worksafe@insp360.ca",
    "EMAIL_FROM_NAME": "QuadReal Work Safe"
  },
  "send_email": [
    { "name": "EMAIL" }
  ],
  "ratelimits": [
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "2001",
      "simple": { "limit": 8, "period": 60 }
    },
    {
      "name": "CHECKIN_LIMITER",
      "namespace_id": "2002",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "DATA_LIMITER",
      "namespace_id": "2003",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
